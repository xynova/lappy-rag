# ── User must provide ────────────────────────────────────────────────────────
MEILI_MASTER_KEY=change-me-before-running
CONTENT_ROOT_BASE=C:/repos
# Optional for private dependency/image builds. Prefer setting in shell.
REGISTRY_USER=
REGISTRY_TOKEN=

# ── Defaults ─────────────────────────────────────────────────────────────────
MEILI_PORT=7700
MEILI_INDEX=documents
INGEST_API_PORT=8090
# ── Embed server ──────────────────────────────────────────────────────────────
EMBED_PORT=8082
EMBED_MODEL=bge-base-en-v1.5
EMBED_DIMENSIONS=768
EMBED_DOCUMENT_TEMPLATE={{doc.embed_text | truncatewords: 512}}
# ── LocalAI ───────────────────────────────────────────────────────────────────
LOCALAI_PORT=8080
LOCALAI_CONTEXT_SIZE=8192
# ── MCP server ────────────────────────────────────────────────────────────────
MCP_PORT=3000
# Comma-separated allowlist. Leave empty to allow all tools (except disabled).
MCP_ENABLED_TOOLS=
# Comma-separated denylist. Takes precedence over MCP_ENABLED_TOOLS.
MCP_DISABLED_TOOLS=list_sources
# ── Corp package registry (optional; leave empty for public internet) ─────────
# REGISTRY_VENDOR: artifactory | nexus (empty = public). When set, GOPROXY path must match vendor.
# When set, DOCKER_REGISTRY_PROXY must end with a trailing slash.
REGISTRY_VENDOR=
PACKAGE_REGISTRY_HOST=
CORP_CA_CERT_URL=
DOCKER_REGISTRY_PROXY=
DOCKER_PUSH_DOMAIN=
PIP_INDEX_URL=
PIP_TRUSTED_HOST=
GOPROXY=
GONOSUMCHECK=*
GOPRIVATE=
GONOSUMDB=
# Artifactory overlay (RFC 2606; replace with your org values):
# REGISTRY_VENDOR=artifactory
# PACKAGE_REGISTRY_HOST=artifactory.example.com
# GOPROXY=https://artifactory.example.com/artifactory/api/go/go-dependencies,direct
# DOCKER_REGISTRY_PROXY=docker-snapshot-dependencies.artifactory.example.com/
# DOCKER_PUSH_DOMAIN=docker-snapshot-local.artifactory.example.com
# CORP_CA_CERT_URL=https://artifactory.example.com/artifactory/generic/security/certificates/corp-ca.pem
# PIP_INDEX_URL=https://artifactory.example.com/artifactory/api/pypi/pypi-virtual/simple
# REGISTRY_GO_CHECK_URL=https://artifactory.example.com/artifactory/api/go/go-dependencies/github.com/spf13/cobra/@v/v1.10.2.zip
# Nexus overlay (RFC 2606; replace with your org values):
# REGISTRY_VENDOR=nexus
# PACKAGE_REGISTRY_HOST=nexus.example.com
# GOPROXY=https://nexus.example.com/repository/go-group,direct
# DOCKER_REGISTRY_PROXY=nexus.example.com:8082/
# DOCKER_PUSH_DOMAIN=nexus.example.com:8083
# CORP_CA_CERT_URL=https://nexus.example.com/repository/raw-hosted/security/certificates/corp-ca.pem
# PIP_INDEX_URL=https://nexus.example.com/repository/pypi-group/simple
# REGISTRY_GO_CHECK_URL=https://nexus.example.com/repository/go-group/github.com/spf13/cobra/@v/v1.10.2.zip
# HTTP_PROXY=http://proxy.example.com:8080
# ── Content ───────────────────────────────────────────────────────────────────
STATE_DIR=/app/state
MAX_CONCURRENT_JOBS=3
MAX_CONCURRENT_PER_PROJECT=1
